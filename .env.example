# FastAPI
ENVIRONMENT=development
DEBUG=true
PORT=8000

# LLM Selection (choose one)
# Option 1: Ollama (local, free)
LLM_PROVIDER=ollama
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mistral  # or llama2, neural-chat, etc.

# Option 2: Claude API (paid, but powerful)
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...

# Embeddings (HuggingFace - free)
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_DIM=384

# Chroma Vector DB
CHROMA_DB_PATH=./data/chroma_db
COLLECTION_NAME=aws_saa_docs

# SQLite Database
SQLITE_DB_PATH=./data/app.db

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+1234567890
TWILIO_VERIFY_TOKEN=your_webhook_token  # For request validation

# Agent Behavior
RAG_RETRIEVAL_TOP_K=5
QUIZ_QUESTIONS_PER_SESSION=5
CHEATSHEET_MAX_LENGTH=500
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100

# Logging
LOG_LEVEL=INFO
